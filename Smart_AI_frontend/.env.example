# VITE_* variables are PUBLIC in the client bundle.
# They are embedded into the built JavaScript at build time and shipped to every
# browser. Only put values that are safe for public disclosure here.
#
# Backend secrets (API keys, JWT secrets, database credentials, BREVO_*, etc.)
# must NEVER be stored in VITE_* variables. They belong on the backend only.
#
# Vite env changes require a fresh build: env values are read at build time,
# so you must re-run `npm run build` (or `npm run dev`) after editing this file.

VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
