# Copy this file to .env.docker (local, gitignored) and fill values
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

MONGO_CONNECTION_STRING=mongodb://mongodb:27017/smart_ai
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=replace_with_your_gemini_api_key

JWT_SECRET=replace_with_a_strong_jwt_secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
JWT_REFRESH_EXPIRE=7d

GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# Transactional email is sent via the Brevo API (no SMTP)
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_FROM_EMAIL=your_sender_email@example.com
BREVO_FROM_NAME=Smart AI

CLOUDINARY_CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_IP_BLOCK_MINUTES=15

# Route-specific rate limits (per IP, sliding 15-minute window)
RATE_LIMIT_AUTH_SESSION_MAX=15
RATE_LIMIT_EMAIL_ACTION_MAX=5
RATE_LIMIT_TOKEN_ACTION_MAX=10
RATE_LIMIT_SEMANTIC_SEARCH_MAX=30

# Trusted proxy hop count for Express req.ip resolution (bounded numeric value).
# 0 = default (local/dev): req.ip is the direct socket address.
# Production (Cloudflare + Render LB): set to the VERIFIED hop count so req.ip
# resolves the real client IP instead of the load-balancer address.
# Never set an unverified arbitrary value and never use "true" (unrestricted trust).
TRUST_PROXY_HOPS=0
